{
  "name": "gazzpush",
  "version": "0.1.0",
  "description": "Open-source verification desk for investigative journalism: claim-by-claim checking against a dossier, quote checks against recordings, document Q&A with verified citations, right of reply, and timestamped defense packages.",
  "keywords": [
    "journalism",
    "investigative-journalism",
    "fact-checking",
    "verification",
    "newsroom",
    "foia",
    "rfc3161",
    "cloudflare-workers"
  ],
  "homepage": "https://github.com/CitadelAgency/gazzpush#readme",
  "bugs": {
    "url": "https://github.com/CitadelAgency/gazzpush/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CitadelAgency/gazzpush.git"
  },
  "license": "AGPL-3.0-only",
  "author": "Citadel Tecnologia LTDA",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev --local-upstream localhost:8787",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit && tsc --noEmit -p test && tsc --noEmit -p web",
    "db:migrate:local": "wrangler d1 migrations apply redacao-db --local",
    "db:migrate": "wrangler d1 migrations apply redacao-db --remote",
    "types": "wrangler types",
    "test": "vitest run",
    "auth:schema": "npx -y auth@1.7.14 generate --config scripts/auth-schema.config.ts --output migrations/0002_auth.sql --yes",
    "web:build": "vite build web",
    "web:dev": "vite build web --watch --mode development",
    "e2e": "playwright test -c web/e2e"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/playwright": "^1.3.6",
    "@mozilla/readability": "^0.6.0",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@tanstack/react-query": "^5.105.0",
    "@tiptap/core": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "asn1js": "^4.0.0",
    "better-auth": "^1.7.14",
    "fflate": "^0.8.3",
    "hono": "^4.13.19",
    "linkedom": "^0.18.14",
    "pkijs": "^4.0.1",
    "postal-mime": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "unpdf": "^2.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.0"
  }
}
