{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": [
      "@types/node",
      "@cloudflare/vitest-plugin/types",
      "vite/client"
    ],
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "./**/*.ts",
    "../scripts/symmetry/**/*.ts",
    "../src/**/*.ts",
    "../web/src/kit/**/*.ts",
    "../web/src/kit/**/*.tsx",
    "../worker-configuration.d.ts",
    "../web/src/onboarding/municipalities.ts",
    "../web/src/onboarding/preview.ts",
    "../web/src/data/**/*.ts"
  ]
}
