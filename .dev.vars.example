# Local development variables. Copy to .dev.vars and fill in.
# In production, set each one with `npx wrangler secret put NAME`.
# Full reference: docs/configuration.md

# --- Required -------------------------------------------------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:8787
# Generate each with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Encrypts social tokens and per-outlet AI keys. Use a different value and keep a backup.
TOKEN_ENC_KEY=
CF_ACCOUNT_ID=<YOUR_ACCOUNT_ID>
# AI Gateway name in your account. Leave empty to call providers directly.
AI_GATEWAY_ID=

# --- AI providers (server fallback; each outlet can add its own keys in the app) ------------------------------------
# Text: drafting, claim checking, document Q&A. One of the two is enough.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
# Second opinion on risky paragraphs (optional). Default model: claude-opus-5-5.
ANTHROPIC_API_KEY=
# SEGUNDA_MODELO=claude-haiku-5-5
# Illustration (optional). Without either, Workers AI is used.
KIE_API_KEY=
FAL_KEY=

# --- Sign-in and Google (optional) ----------------------------------------------------------------------------------
# Google sign-in. Redirect URI: <PUBLIC_BASE_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# With the two above, enables Google Docs import (docs/integrations.md#google-docs).
GOOGLE_API_KEY=
GOOGLE_PROJECT_NUMBER=
# Comma-separated user ids allowed to use /api/admin/* (ids, not emails: sign-up does not verify email).
ADMIN_USER_IDS=

# --- Legal shield (optional) ----------------------------------------------------------------------------------------
# Sender for right-of-reply emails. Needs the "EMAIL" send_email binding and a domain in Cloudflare Email Service.
# EMAIL_REMETENTE=
# Internet Archive S3 keys for Save Page Now with higher limits. Without them, the public endpoint is used.
# WAYBACK_ACCESS_KEY=
# WAYBACK_SECRET=
# RFC 3161 timestamp authority (default https://freetsa.org/tsr) and its trusted root (DER in base64, required with TSA_URL).
# TSA_URL=
# TSA_RAIZ=

# --- Brazil-specific (optional) -------------------------------------------------------------------------------------
# Public DataJud (CNJ) key, to follow court cases cited in stories. Review DataJud's terms of use first.
# DATAJUD_API_KEY=

# --- Search -----------------------------------------------------------------------------------------------------------
# Set to "desligada" to use keyword-only search in documents.
# BUSCA_VETORIAL=

# --- Reels on Windows -----------------------------------------------------------------------------------------------
# `wrangler dev` cannot run containers on Windows. Point to a container started with `docker run` (docs/self-hosting.md).
# REELS_URL_LOCAL=http://localhost:8080

# --- Billing (only for a paid hosted service; leave unset when self-hosting) ----------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRECO_PAGINA=
# STRIPE_PRECO_PORTAL=

# --- Test-only overrides (do not set in production) -----------------------------------------------------------------
# DEEPSEEK_URL= GEMINI_URL= SEGUNDA_URL= KIE_URL= FAL_URL= WHISPER_URL= WAYBACK_URL= DATAJUD_URL= STRIPE_URL=
