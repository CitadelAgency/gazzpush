{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "redacao",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": { "INSTALACAO_PROPRIA": "1" },

  // Custom domain: uncomment and set your hostname. Without it, the app is served on workers.dev. Cookies and CSRF
  // are bound to the origin in PUBLIC_BASE_URL, so serve the app from a single host.
  // "routes": [{ "pattern": "<SEU_DOMINIO>", "custom_domain": true }],
  // "workers_dev": false,

  // Web app (Vite + React in web/, "npm run web:build"). API, media, health and public pages go through the Worker;
  // everything else is a static file, and unknown paths return the SPA's index.html.
  "assets": {
    "directory": "web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*", "/health", "/fontes/*", "/anuncio/*", "/v/*", "/stripe/*"]
  },

  // Card templates and fonts are bundled: rendering makes no external requests.
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.woff2"], "fallthrough": true }
  ],

  // Every 15 min: enqueue due sources. 09:00 UTC: re-read dossiers, court cases, FOI deadlines. 21:00 UTC: daily digest.
  "triggers": { "crons": ["*/15 * * * *", "0 9 * * *", "0 21 * * *"] },

  "d1_databases": [{
    "binding": "DB",
    "database_name": "redacao-db",
    "database_id": "<D1_DATABASE_ID>",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "redacao-media" }],
  "kv_namespaces": [{ "binding": "CONFIG", "id": "<KV_NAMESPACE_ID>" }],
  "queues": {
    "producers": [{ "binding": "MONITOR_QUEUE", "queue": "redacao-monitor" }],
    "consumers": [{
      "queue": "redacao-monitor",
      "max_batch_size": 10,
      "max_batch_timeout": 5,
      "max_retries": 3,
      "dead_letter_queue": "redacao-monitor-dlq"
    }]
  },
  // Two short Workflows, no waitForEvent: production ends in review; approval starts publishing.
  "workflows": [
    { "name": "redacao-producao", "binding": "PRODUCAO_WORKFLOW", "class_name": "ProducaoWorkflow" },
    { "name": "redacao-publicacao", "binding": "PUBLICACAO_WORKFLOW", "class_name": "PublicacaoWorkflow" }
  ],
  // Reels: HyperFrames + headless Chrome + FFmpeg in a Cloudflare Container (container/reels/), behind the
  // ReelsContainer Durable Object. Requires Workers Paid and Docker on the deploy machine (docs/self-hosting.md).
  // `wrangler dev` cannot run containers on Windows, so they are disabled in dev; set REELS_URL_LOCAL in .dev.vars to
  // use a container started with `docker run`. On Linux/WSL: `wrangler dev --enable-containers`.
  "dev": { "enable_containers": false },
  "containers": [{
    "class_name": "ReelsContainer",
    "image": "./container/reels/Dockerfile",
    "instance_type": "standard-3",
    "max_instances": 3
  }],
  "durable_objects": { "bindings": [{ "name": "REELS", "class_name": "ReelsContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReelsContainer"] }],
  // remote: true → in `wrangler dev` these bindings call the real service (there is no local emulation).
  "ai": { "binding": "AI", "remote": true },
  "browser": { "binding": "BROWSER", "remote": true },
  "vectorize": [
    { "binding": "DEDUPE", "index_name": "redacao-dedupe", "remote": true },
    // Ask the document: bge-m3, 1024 dimensions, cosine; one namespace per file.
    { "binding": "DOCS_VETOR", "index_name": "redacao-documentos", "remote": true }
  ],
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "redacao_metrics" }]
}
